{
  "name": "filmkatalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persönlicher Filmsammlung-Katalog als PWA (read-only, offline-fähig)",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:series": "node scripts/build-series.mjs",
    "icons": "node scripts/make-icons.mjs",
