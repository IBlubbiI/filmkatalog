# TMDB-Zugang für das Build-Skript (scripts/build-data.mjs).
# Kopiere diese Datei zu ".env" und trage EINEN der beiden Werte ein.
# Registrierung: https://www.themoviedb.org/settings/api
# (Bei "Application URL" reicht ein Platzhalter wie http://localhost)
#
# Variante A – v3 API Key (kurz):
TMDB_API_KEY=

# Variante B – v4 Read Access Token (langer JWT, beginnt mit "eyJ"):
# TMDB_READ_ACCESS_TOKEN=
